{
    "name": "pushinbr/pam-browser",
    "description": "Typed Chrome DevTools Protocol client for the PAM runtime.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "browser",
        "cdp",
        "chrome",
        "chromium",
        "pam",
        "php"
    ],
    "homepage": "https://github.com/push-in/pam",
    "support": {
        "issues": "https://github.com/push-in/pam/issues",
        "source": "https://github.com/push-in/pam-browser"
    },
    "require": {
        "php": "^8.5"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Browser\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.phpstan-cache",
            "/.phpunit.cache",
            "/vendor"
        ]
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "test": "phpunit --configuration=phpunit.xml",
        "test:legacy": "php tests/run.php",
        "test:integration": "pam tests/integration/chromium.php",
        "verify": [
            "@analyse",
            "@test",
            "@test:integration"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    }
}
